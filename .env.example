# Sandiwa OS HOA — environment placeholders (POC uses localStorage; no secrets required)

# Platform apex domain (tenant URLs are auto-routed per environment)
# Local:  subdomain — {slug}.sandiwa.localhost
# Vercel: path-based — sandiwa-os.vercel.app/o/{slug}
# Custom domain: subdomain — {slug}.sandiwa.os
NUXT_PUBLIC_PLATFORM_DOMAIN=sandiwa.localhost

# Tenant routing: auto | subdomain | path
# auto (default): subdomain locally / on custom domains, path on *.vercel.app
# subdomain: always {slug}.{platformDomain}
# path: always {platformDomain}/o/{slug}
NUXT_PUBLIC_TENANT_ROUTING=auto

# Future: Supabase production backend
# NUXT_PUBLIC_SUPABASE_URL=
# NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Future: AI intake triage (Nitro server routes)
# NUXT_AI_API_KEY=

# Future: Payments (PayMongo / Xendit)
# NUXT_PAYMONGO_SECRET_KEY=

# Future: SMS broadcasts (Semaphore / Twilio)
# NUXT_SMS_API_KEY=
