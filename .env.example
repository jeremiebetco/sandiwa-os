# Sandiwa OS HOA — environment

# Postgres — app role (RLS enforced). Admin URL used for migrate/seed only.
DATABASE_URL=postgresql://sandiwa_app:sandiwa@localhost:5433/sandiwa_os
DATABASE_URL_ADMIN=postgresql://sandiwa:sandiwa@localhost:5433/sandiwa_os

# Password for sandiwa_app (pnpm db:migrate, or set in server/db/supabase/02_rls.sql)
# SANDIWA_APP_DB_PASSWORD=change-me-in-production

# Session HMAC secret (required in production: ≥32 chars, not a placeholder)
SESSION_SECRET=local-dev-session-secret-min-32-chars

# Platform apex domain (tenant URLs are auto-routed per environment)
# Local:  subdomain — {slug}.sandiwa.localhost
# Vercel: path-based — sandiwa-os.vercel.app/o/{slug}
# Custom domain: subdomain — {slug}.sandiwa.os
NUXT_PUBLIC_PLATFORM_DOMAIN=sandiwa.localhost

# Tenant routing: auto | subdomain | path
# auto (default): subdomain locally / on custom domains, path on *.vercel.app
# subdomain: always {slug}.{platformDomain}
# path: always {platformDomain}/o/{slug}
NUXT_PUBLIC_TENANT_ROUTING=auto

# Allow platform UI "Reset demo data" (local only). Never set on Vercel/production.
# ALLOW_DEMO_RESET=true

# Reserved, unused — intake auto-triage (not built)
# NUXT_AI_API_KEY=

# Reserved, unused — PayMongo / Xendit (not built)
# NUXT_PAYMONGO_SECRET_KEY=

# Reserved, unused — SMS delivery (not built)
# NUXT_SMS_API_KEY=
