# Sandiwa OS HOA — environment placeholders (POC uses localStorage; no secrets required)

# Platform apex domain (tenant subdomains are {slug}.{platformDomain})
# Local:  sandiwa.localhost
# Vercel: sandiwa-os.vercel.app
# Prod:   sandiwa.os
NUXT_PUBLIC_PLATFORM_DOMAIN=sandiwa.localhost

